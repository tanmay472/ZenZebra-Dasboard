# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# captured/reference artifacts (Only ignore these if you don't want them tracked)
# /Dashboard.html
# /saved_resource.html
# /erp.ctaapparels.com/

# misc
.DS_Store
*.pem
*.sh

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production
.env.worker

# deploy/*.sh runtime artifacts — local logs, DB dumps, and per-VM state,
# none of which belong in git.
deploy/logs/
deploy/backups/
deploy/.supervisor
deploy/.last_good_commit

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# environment
.node/
.npm/
.yarn/

# one-off scripts with hardcoded DB credentials - never commit
/run-migrations.mjs
/setup-db.mjs
/test-connection.mjs

# AI-generated report files (xlsx/pdf) — regenerated on demand, not source
/data/ai-reports/
legacy-root-scripts/reports/
legacy-root-scripts/*.xlsx
legacy-root-scripts/_*.json
